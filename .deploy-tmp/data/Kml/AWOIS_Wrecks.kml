<description><![CDATA[<center><table><tr><th colspan='2' align='center'><em>Attributes</em></th></tr><tr bgcolor="#E3E3F3">
<th>RECRD</th>
<td>1659</td>
</tr><tr bgcolor="">
<th>VESSLTERMS</th>
<td>DOROTHY & MARY</td>
</tr><tr bgcolor="#E3E3F3">
<th>FEATURE_TYPE</th>
<td>Wreck - Submerged, nondangerous</td>
</tr><tr bgcolor="">
<th>LATDEC</th>
<td>40.602511</td>
</tr><tr bgcolor="#E3E3F3">
<th>LONDEC</th>
<td>-70.1095</td>
</tr><tr bgcolor="">
