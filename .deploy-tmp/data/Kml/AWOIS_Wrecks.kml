<td>CITY OF HARTFORD</td>
</tr><tr bgcolor="#E3E3F3">
<th>FEATURE_TYPE</th>
<td>Wreck - Submerged, dangerous to surface navigation</td>
</tr><tr bgcolor="">
<th>LATDEC</th>
<td>40.943333</td>
