<td>AMERICAN</td>
</tr><tr bgcolor="#E3E3F3">
<th>FEATURE_TYPE</th>
<td>Wreck - Submerged, dangerous to surface navigation</td>
</tr><tr bgcolor="">
<th>LATDEC</th>
<td>39.244744</td>
</tr><tr bgcolor="#E3E3F3">
<th>LONDEC</th>
<td>-74.380464</td>
